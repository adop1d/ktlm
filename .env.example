# Copia esto a .env y cámbialo todo. El .env no se versiona; este sí, porque no lleva
# nada dentro: solo nombres y la forma de generar lo que falta.
#
#   cp .env.example .env
#   # y luego, para las dos claves que hay que inventar:
#   echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
#   echo "DB_PASSWORD=$(openssl rand -base64 24)" >> .env

# --- Credenciales -------------------------------------------------------------
# Clave de firma del JWT. Sin valor por defecto a propósito: arrancar sin ella tiene que
# fallar, no firmar con algo que esté en el repositorio y que cualquiera pueda leer.
# openssl rand -base64 48
JWT_SECRET=

# Contraseña del superusuario de Postgres.
# openssl rand -base64 24
DB_PASSWORD=

# --- Base de datos ------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USERNAME=postgres

# --- Backend ------------------------------------------------------------------
SERVER_PORT=8080
# DEBUG imprime cada consulta SQL y el interior de la autenticación. En INFO no aparece
# nada de eso.
LOG_LEVEL=INFO

# --- Frontend -----------------------------------------------------------------
# Solo se lee en el navegador, así que cualquier valor que Pongas aquí acaba en el bundle
# publicado. Nada de secretos: para eso está el backend.
VITE_API_URL=http://localhost:8080

# --- Servidor MCP (opcional) --------------------------------------------------
# Token de servicio, en la barra de la app: «tokens».
# KTM_SERVICE_TOKEN=