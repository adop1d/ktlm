# The build context for this build is ./frontend. The Dockerfile does `COPY . .`, so without
# this file a .env with VITE_* travels into the builder layer.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output: the build regenerates them
node_modules/
dist/
coverage/

# Test results
test-results/
playwright-report/
blob-report/
.playwright/

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp
*.bak
